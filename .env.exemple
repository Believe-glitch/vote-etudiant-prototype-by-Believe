# =====================================================================
# Modèle du fichier .env
#
# 1. Fais une copie de ce fichier et nomme-la exactement :  .env
# 2. Remplis les valeurs ci-dessous.
#
# Le fichier .env contient des secrets : il ne part JAMAIS sur GitHub
# (il est listé dans .gitignore). Ne l'envoie à personne.
# =====================================================================

# Adresse de ta base Neon : dans Neon, bouton « Connect », puis copie
# l'adresse « pooled » (celle qui contient "-pooler").
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-exemple-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clé secrète des codes de vote : au moins 32 caractères au hasard.
# Pour en fabriquer une, tape dans le terminal de VS Code :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : mets la MÊME clé ici et sur Render. Si tu la changes,
# tous les codes déjà distribués deviennent invalides.
CODE_SECRET=remplace-moi-par-une-longue-cle-au-hasard

# "oui" pour remplir une base vide avec les étudiants et candidats de
# démonstration. Mets "non" pour le vrai scrutin.
DONNEES_DEMO=oui

# Mot de passe des comptes de démonstration (superviseur, distributeur,
# observateur). Au moins 8 caractères. Laisse vide pour ne pas les créer.
DEMO_MOT_DE_PASSE=choisis-un-mot-de-passe

# Base À PART, utilisée seulement par « npm test » (elle est entièrement
# vidée à chaque fois). Ne mets JAMAIS ici l'adresse de DATABASE_URL.
TEST_DATABASE_URL=
